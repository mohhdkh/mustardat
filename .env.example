# Lost & Found Backend - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Leave DATABASE_URL empty to use SQLite locally. In production, paste the
# Supabase session-pooler connection string (port 5432).
DATABASE_URL=
DATABASE_PATH=./data/lostfound.db

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET_KEY=your-super-secret-key-change-in-production
DATA_ENCRYPTION_KEY=replace-with-an-independent-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# STORAGE CONFIGURATION
# ===========================================
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=mustardat-images
SUPABASE_STORAGE_PUBLIC=true

# ===========================================
# IMAGE PROCESSING
# ===========================================
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
YOLO_MODEL_PATH=yolov8n.pt
CLIP_MODEL_NAME=ViT-B/32

# ===========================================
# MATCHING CONFIGURATION
# ===========================================
DEFAULT_SEARCH_RADIUS_KM=50
DEFAULT_TIME_RANGE_DAYS=30
VECTOR_SIMILARITY_THRESHOLD=0.7
TOP_K_VECTOR_RESULTS=50
FINAL_TOP_K_MATCHES=10

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# ===========================================
# APPLICATION SETTINGS
# ===========================================
DEBUG=True
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
