# Lost & Found - Docker Environment Variables Example
# Copy this file to .env.docker and modify for your deployment

# ===========================================
# DATABASE CONFIGURATION (SQLite)
# ===========================================
DATABASE_PATH=/app/data/lostfound.db

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# IMPORTANT: Change this to a secure random string in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# LOCAL STORAGE CONFIGURATION
# ===========================================
UPLOAD_DIR=/app/data/uploads

# ===========================================
# IMAGE PROCESSING
# ===========================================
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
YOLO_MODEL_PATH=/app/yolov8n.pt
CLIP_MODEL_NAME=ViT-B/32

# ===========================================
# MATCHING CONFIGURATION
# ===========================================
DEFAULT_SEARCH_RADIUS_KM=50
DEFAULT_TIME_RANGE_DAYS=30
VECTOR_SIMILARITY_THRESHOLD=0.7
TOP_K_VECTOR_RESULTS=50
FINAL_TOP_K_MATCHES=10

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ===========================================
# APPLICATION SETTINGS
# ===========================================
DEBUG=false
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
